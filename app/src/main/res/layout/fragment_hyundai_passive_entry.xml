<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    tools:context=".ui.hyundaiPassiveEntry.HyundaiPassiveEntryFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/activity_vertical_margin">

        <!-- Title -->
        <TextView
            android:id="@+id/hyundai_passive_entry_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="10dp"
            android:text="@string/menu_hyundai_passive_entry"
            android:textColor="@color/text_color"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Description -->
        <TextView
            android:id="@+id/hyundai_passive_entry_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="20dp"
            android:text="@string/hyundai_passive_entry_description"
            android:textColor="@color/text_color"
            android:textSize="14sp" />

        <!-- Card for variants -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="@dimen/cornerRadiusCardview"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="10dp"
                    android:text="@string/hyundai_passive_entry_select_variant"
                    android:textColor="@color/text_color"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/hyundai_passive_entry_radio_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/hyundai_passive_entry_radio_default"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hyundai_passive_entry_default"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/hyundai_passive_entry_radio_variant1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hyundai_passive_entry_variant1" />

                    <RadioButton
                        android:id="@+id/hyundai_passive_entry_radio_variant2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hyundai_passive_entry_variant2" />

                    <RadioButton
                        android:id="@+id/hyundai_passive_entry_radio_variant3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hyundai_passive_entry_variant3" />

                    <RadioButton
                        android:id="@+id/hyundai_passive_entry_radio_variant4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hyundai_passive_entry_variant4" />

                </RadioGroup>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Card for custom input -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="@dimen/cornerRadiusCardview"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="10dp"
                    android:text="@string/hyundai_passive_entry_custom_data"
                    android:textColor="@color/text_color"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hyundai_passive_entry_custom_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/hyundai_passive_entry_custom_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Control buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/hyundai_passive_entry_start_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/hyundai_passive_entry_start"
                android:backgroundTint="@color/green_normal" />

            <Button
                android:id="@+id/hyundai_passive_entry_stop_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/hyundai_passive_entry_stop"
                android:backgroundTint="@color/log_error"
                android:enabled="false" />

        </LinearLayout>

        <!-- Info text -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/hyundai_passive_entry_info"
            android:textColor="@color/grey_normal"
            android:textSize="12sp"
            android:textStyle="italic" />

    </LinearLayout>

</ScrollView>
